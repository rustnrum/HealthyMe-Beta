    @SuppressLint("MissingPermission")
    fun read(
        deviceId: String,
        deviceName: String,
        protocolId: String,
        durationMs: Long,
        cpapPasskey: String?,
        result: MethodChannel.Result,
    ) {
        if (!hasBluetoothPermission()) {
            result.error(
                "BLE_PERMISSION_DENIED",
                "Bluetooth scan/connect permission is required.",
                null,
            )
            return
        }

        val adapter =
            activity.getSystemService(BluetoothManager::class.java)?.adapter
        if (adapter == null || !adapter.isEnabled) {
            result.error(
                "BLE_UNAVAILABLE",
                "Bluetooth is unavailable or turned off.",
                null,
            )
            return
        }

        val device = try {
            adapter.getRemoteDevice(deviceId)
        } catch (error: Throwable) {
            result.error(
                "BLE_DEVICE_INVALID",
                error.message ?: "Invalid Bluetooth address.",
                null,
            )
            return
        }

        Session(device, deviceName, protocolId, durationMs, cpapPasskey, result).start()
    }

    @SuppressLint("MissingPermission")
    private inner class Session(
        private val device: BluetoothDevice,
        private val deviceName: String,
        private val protocolId: String,
        private val durationMs: Long,
        private val cpapPasskey: String?,
        private val result: MethodChannel.Result,
    ) {
        private val completed = AtomicBoolean(false)
        private val metrics = linkedMapOf<String, Double>()
        private val notes = mutableListOf<String>()
        private var readerName = "Bluetooth protocol"
        private var mode = "unknown"
        private var gatt: BluetoothGatt? = null

        // COLMI / QRing state.
        private var ringWrite: BluetoothGattCharacteristic? = null
        private var ringNotify: BluetoothGattCharacteristic? = null
        private var ringBigWrite: BluetoothGattCharacteristic? = null
        private var ringBigNotify: BluetoothGattCharacteristic? = null
        private var ringNotifyStage = 0
        private val ringBigBuffer = ByteArrayOutputStream()
        private var ringStepTotal = 0
        private var ringCaloriesTotal = 0
        private var ringNewCalorieProtocol = false
        private var ringLatestHr = 0
        private var ringHrvPageCount = 0
        private var ringHrvProxySum = 0
        private var ringHrvProxyCount = 0
        private var ringSleepSeen = false
        private var ringSpo2Requested = false

        // Garmin Multi-Link state.
        private var garminRx: BluetoothGattCharacteristic? = null
        private var garminTx: BluetoothGattCharacteristic? = null
        private val garminHandleToService = mutableMapOf<Int, Int>()
        private val garminRrMs = mutableListOf<Double>()
        private var garminRegisterIndex = 0
        private var garminPendingService: Int? = null
        private var garminRegistrationStarted = false

        // ResMed read-only probe state. We intentionally do not write to any
        // proprietary characteristic. The only descriptor write is the
        // standard CCCD needed to subscribe to notifications/indications.
        private val cpapReadQueue = mutableListOf<BluetoothGattCharacteristic>()
        private val cpapNotifyQueue = mutableListOf<BluetoothGattCharacteristic>()
        private val cpapObservations = linkedMapOf<String, String>()
        private var cpapReadIndex = 0
        private var cpapNotifyIndex = 0
        private var cpapReadCount = 0
        private var cpapNotificationCount = 0
        private var cpapSubscriptions = 0

        // AirSense 11 FIG + secure-session state. Only read-only application
        // RPCs are issued after authentication.
        private var cpapTx: BluetoothGattCharacteristic? = null
        private var cpapRx: BluetoothGattCharacteristic? = null
        private var cpapSessionStarted = false
        private var cpapAuthenticated = false
        private var cpapPairingRequired = false
        private var cpapRpcId = 100
        private var cpapPendingMethod = ""
        private val cpapFigBuffer = ByteArrayOutputStream()
        private val cpapRandom = SecureRandom()
        private var cpapSrpPrivate: BigInteger? = null
        private var cpapSrpPublic: BigInteger? = null
        private var cpapMasterPairKey: ByteArray? = null
        private var cpapExpectedServerProof: ByteArray? = null
        private var cpapPendingNonce: ByteArray? = null
        private var cpapSessionKey: ByteArray? = null
        private val cpapWriteQueue = java.util.ArrayDeque<ByteArray>()
        private var cpapWriteBusy = false

        private val callback = object : BluetoothGattCallback() {
            override fun onConnectionStateChange(
                gatt: BluetoothGatt,
                status: Int,
                newState: Int,
            ) {
                this@Session.gatt = gatt

                if (
                    status == BluetoothGatt.GATT_SUCCESS &&
                    newState == BluetoothProfile.STATE_CONNECTED
                ) {
                    val started = try {
                        gatt.discoverServices()
                    } catch (_: Throwable) {
                        false
                    }
                    if (!started) {
                        finish("Connected, but service discovery could not start.")
                    }
                    return
                }

                if (
                    newState == BluetoothProfile.STATE_DISCONNECTED &&
                    !completed.get()
                ) {
                    finish("The device disconnected before direct sync completed.")
                } else if (
                    status != BluetoothGatt.GATT_SUCCESS &&
                    !completed.get()
                ) {
                    finish("Bluetooth connection failed with status $status.")
                }
            }

            override fun onServicesDiscovered(
                gatt: BluetoothGatt,
                status: Int,
            ) {
                if (status != BluetoothGatt.GATT_SUCCESS) {
                    finish("Bluetooth service discovery failed with status $status.")
                    return
                }

                val cpapIdentity = protocolId == "cpap-family" ||
                    deviceName.lowercase().contains("resmed") ||
                    deviceName.lowercase().contains("airsense") ||
                    deviceName.lowercase().contains("aircurve") ||
                    gatt.getService(RESMED_ADVERTISED_SERVICE) != null ||
                    gatt.getService(RESMED_DEVICE_SERVICE) != null
                if (cpapIdentity) {
                    startCpapProbe(gatt)
                    return
                }

                val ringService = gatt.getService(RING_SERVICE)
                if (ringService != null) {
                    startRing(gatt, ringService)
                    return
                }

                val garminService = gatt.getService(GARMIN_SERVICE)
                if (garminService != null) {
                    startGarmin(gatt, garminService)
                    return
                }

                finish(
                    "No supported COLMI/QRing or Garmin direct protocol was found on $deviceName.",
                    fallbackStandard = true,
                )
            }

            override fun onDescriptorWrite(
                gatt: BluetoothGatt,
                descriptor: BluetoothGattDescriptor,
                status: Int,
            ) {
                if (completed.get()) return

                if (mode == "cpap") {
                    if (status == BluetoothGatt.GATT_SUCCESS) {
                        cpapSubscriptions += 1
                    } else {
                        notes.add(
                            "A ResMed notification subscription returned status $status."
                        )
                    }
                    cpapNotifyIndex += 1
                    setupNextCpapNotification()
                    return
                }

                if (status != BluetoothGatt.GATT_SUCCESS) {
                    finish("Bluetooth notification setup failed with status $status.")
                    return
                }

                if (mode == "ring") {
                    when (descriptor.characteristic.uuid) {
                        RING_NOTIFY -> {
                            val big = ringBigNotify
                            if (big != null && ringBigWrite != null) {
                                ringNotifyStage = 2
                                if (!enableNotify(gatt, big)) {
                                    ringNotifyStage = 3
                                    startRingRequests()
                                }
                            } else {
                                ringNotifyStage = 3
                                startRingRequests()
                            }
                        }
                        RING_BIG_NOTIFY -> {
                            ringNotifyStage = 3
                            startRingRequests()
                        }
                    }
                } else if (mode == "garmin") {
                    if (descriptor.characteristic.uuid == garminRx?.uuid) {
                        startGarminHandshake()
                    }
                }
            }

            override fun onCharacteristicWrite(
                gatt: BluetoothGatt,
                characteristic: BluetoothGattCharacteristic,
                status: Int,
            ) {
                if (mode == "cpap" && characteristic.uuid == RESMED_TX) {
                    cpapWriteBusy = false
                    if (status != BluetoothGatt.GATT_SUCCESS) {
                        finish("ResMed transport write failed with status $status.")
                        return
                    }
                    writeNextCpapChunk()
                }
            }

            @Deprecated("Deprecated in Java")
            override fun onCharacteristicRead(
                gatt: BluetoothGatt,
                characteristic: BluetoothGattCharacteristic,
                status: Int,
            ) {
                if (mode != "cpap" || completed.get()) return
                val value = characteristic.value ?: byteArrayOf()
                handleCpapRead(characteristic.uuid, value, status)
            }

            override fun onCharacteristicRead(
                gatt: BluetoothGatt,
                characteristic: BluetoothGattCharacteristic,
                value: ByteArray,
                status: Int,
            ) {
                if (mode != "cpap" || completed.get()) return
                handleCpapRead(characteristic.uuid, value, status)
            }

            @Deprecated("Deprecated in Java")
            override fun onCharacteristicChanged(
                gatt: BluetoothGatt,
                characteristic: BluetoothGattCharacteristic,
            ) {
                val value = characteristic.value ?: return
                handleChanged(characteristic.uuid, value)
            }

            override fun onCharacteristicChanged(
                gatt: BluetoothGatt,
                characteristic: BluetoothGattCharacteristic,
                value: ByteArray,
            ) {
                handleChanged(characteristic.uuid, value)
            }
        }

        fun start() {
            try {
                gatt = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
                    device.connectGatt(
                        activity,
                        false,
                        callback,
                        BluetoothDevice.TRANSPORT_LE,
                    )
                } else {
                    @Suppress("DEPRECATION")
                    device.connectGatt(activity, false, callback)
                }
            } catch (error: Throwable) {
                result.error(
                    "BLE_GATT_CONNECT_FAILED",
                    error.message ?: error.javaClass.simpleName,
                    null,
                )
                return
            }

            mainHandler.postDelayed(
                {
                    if (!completed.get()) {
                        finish(
                            if (metrics.isEmpty()) {
                                "$readerName connected, but no real metric packets arrived before timeout."
                            } else {
                                null
                            }
                        )
                    }
                },
                durationMs + 2500L,
            )
        }

        private fun handleChanged(uuid: UUID, value: ByteArray) {
            if (completed.get()) return
            if (mode == "cpap") {
                cpapNotificationCount += 1
                recordCpapObservation("notify", uuid, value)
                if (uuid == RESMED_RX) {
                    handleCpapTransport(value)
                }
                return
            }
            when {
                uuid == RING_NOTIFY -> parseRingPacket(value)
                uuid == RING_BIG_NOTIFY -> parseRingBigData(value)
                uuid == garminRx?.uuid -> parseGarminPacket(value)
            }
        }

        private fun finish(
            message: String? = null,
            fallbackStandard: Boolean = false,
        ) {
            if (!completed.compareAndSet(false, true)) return

            if (garminRrMs.size >= 3 && !metrics.containsKey("HRV")) {
                var sumSquares = 0.0
                for (index in 1 until garminRrMs.size) {
                    val delta = garminRrMs[index] - garminRrMs[index - 1]
                    sumSquares += delta * delta
                }
                metrics["HRV"] =
                    sqrt(sumSquares / (garminRrMs.size - 1))
            }

            if (ringHrvProxyCount > 0) {
                metrics["Ring HRV proxy"] =
                    ringHrvProxySum.toDouble() / ringHrvProxyCount.toDouble()
            }

            try {
                gatt?.disconnect()
            } catch (_: Throwable) {
            }
            try {
                gatt?.close()
            } catch (_: Throwable) {
            }

            val cpapMessage = if (mode == "cpap" && message == null) {
                if (cpapAuthenticated) {
                    "ResMed secure session established. Read ${metrics.size} verified therapy metric${if (metrics.size == 1) "" else "s"}."
                } else if (cpapPairingRequired) {
                    "Secure ResMed pairing is required. Put the AirSense in Bluetooth pairing mode, enter the 4-digit code shown on its screen, then run Secure sync again."
                } else {
                    "ResMed connected, but a secure application session was not established before timeout."
                }
            } else {
                null
            }

            val finalMessage = cpapMessage ?: message ?: when {
                metrics.isNotEmpty() ->
                    "$readerName returned ${metrics.size} real metric${if (metrics.size == 1) "" else "s"}."
                notes.isNotEmpty() -> notes.joinToString(" ")
                else -> "No health packets were returned by this device."
            }

            mainHandler.post {
                result.success(
                    mapOf(
                        "reader" to readerName,
                        "metrics" to metrics,
                        "message" to finalMessage,
                        "fallbackStandard" to fallbackStandard,
                        "observations" to if (mode == "cpap") {
                            cpapObservations.entries.map { entry ->
                                mapOf("label" to entry.key, "hex" to entry.value)
                            }
                        } else {
                            emptyList<Map<String, String>>()
                        },
                        "diagnostics" to if (mode == "cpap") {
                            mapOf(
                                "readCount" to cpapReadCount,
                                "notificationCount" to cpapNotificationCount,
                                "subscriptionCount" to cpapSubscriptions,
                                "authenticated" to if (cpapAuthenticated) 1 else 0,
                                "pairingRequired" to if (cpapPairingRequired) 1 else 0,
                            )
                        } else {
                            emptyMap<String, Int>()
                        },
                    )
                )
            }
        }

        private fun u16(bytes: ByteArray, offset: Int): Int {
            if (offset + 1 >= bytes.size) return 0
            return (bytes[offset].toInt() and 0xff) or
                ((bytes[offset + 1].toInt() and 0xff) shl 8)
        }

        private fun u32(bytes: ByteArray, offset: Int): Long {
            if (offset + 3 >= bytes.size) return 0L
            return (bytes[offset].toLong() and 0xffL) or
                ((bytes[offset + 1].toLong() and 0xffL) shl 8) or
                ((bytes[offset + 2].toLong() and 0xffL) shl 16) or
                ((bytes[offset + 3].toLong() and 0xffL) shl 24)
        }

        @Suppress("DEPRECATION")
        private fun writeCharacteristic(
            gatt: BluetoothGatt,
            characteristic: BluetoothGattCharacteristic,
            data: ByteArray,
        ): Boolean {
            characteristic.writeType =
                if (
                    characteristic.properties and
                    BluetoothGattCharacteristic.PROPERTY_WRITE_NO_RESPONSE != 0
                ) {
                    BluetoothGattCharacteristic.WRITE_TYPE_NO_RESPONSE
                } else {
                    BluetoothGattCharacteristic.WRITE_TYPE_DEFAULT
                }
            characteristic.value = data
            return try {
                gatt.writeCharacteristic(characteristic)
            } catch (_: Throwable) {
                false
            }
        }

        @Suppress("DEPRECATION")
        private fun enableNotify(
            gatt: BluetoothGatt,
            characteristic: BluetoothGattCharacteristic,
        ): Boolean {
            val enabled = try {
                gatt.setCharacteristicNotification(characteristic, true)
            } catch (_: Throwable) {
                false
            }
            if (!enabled) return false

            val descriptor = characteristic.getDescriptor(CCCD) ?: return true
            descriptor.value =
                if (
                    characteristic.properties and
                    BluetoothGattCharacteristic.PROPERTY_INDICATE != 0
                ) {
                    BluetoothGattDescriptor.ENABLE_INDICATION_VALUE
                } else {
                    BluetoothGattDescriptor.ENABLE_NOTIFICATION_VALUE
                }
            return try {
                gatt.writeDescriptor(descriptor)
            } catch (_: Throwable) {
                false
            }
        }

        // -----------------------------------------------------------------
        // ResMed read-only BLE probe.
        //
        // AirSense/AirCurve application traffic can require a device-specific
        // secure session. Build 33 therefore performs only passive reads and
        // standard notification subscriptions. It never writes proprietary
        // commands or therapy settings.
        // -----------------------------------------------------------------

        private fun startCpapProbe(gatt: BluetoothGatt) {
            readerName = "ResMed AirSense 11 secure read-only reader"
            mode = "cpap"
            cpapReadQueue.clear()
            cpapNotifyQueue.clear()
            cpapObservations.clear()
            cpapReadIndex = 0
            cpapNotifyIndex = 0
            cpapReadCount = 0
            cpapNotificationCount = 0
            cpapSubscriptions = 0
            cpapSessionStarted = false
            cpapAuthenticated = false
            cpapPairingRequired = false
            cpapFigBuffer.reset()
            cpapWriteQueue.clear()
            cpapWriteBusy = false
            cpapTx = null
            cpapRx = null

            for (service in gatt.services) {
                for (characteristic in service.characteristics) {
                    if (characteristic.uuid == RESMED_TX) cpapTx = characteristic
                    if (characteristic.uuid == RESMED_RX) cpapRx = characteristic
                    val properties = characteristic.properties
                    if (
                        properties and BluetoothGattCharacteristic.PROPERTY_READ != 0
                    ) {
                        cpapReadQueue.add(characteristic)
                    }
                    if (
                        properties and BluetoothGattCharacteristic.PROPERTY_NOTIFY != 0 ||
                        properties and BluetoothGattCharacteristic.PROPERTY_INDICATE != 0
                    ) {
                        cpapNotifyQueue.add(characteristic)
                    }
                }
            }

            notes.add(
                "ResMed GATT exposed ${cpapReadQueue.size} readable and " +
                    "${cpapNotifyQueue.size} notify/indicate characteristics."
            )

            if (cpapReadQueue.isNotEmpty()) {
                readNextCpapCharacteristic()
            } else {
                setupNextCpapNotification()
            }
        }

        @Suppress("DEPRECATION")
        private fun readNextCpapCharacteristic() {
            if (completed.get()) return
            val activeGatt = gatt ?: return
            while (cpapReadIndex < cpapReadQueue.size) {
                val characteristic = cpapReadQueue[cpapReadIndex]
                val started = try {
                    activeGatt.readCharacteristic(characteristic)
                } catch (_: Throwable) {
                    false
                }
                if (started) return
                cpapReadIndex += 1
            }
            setupNextCpapNotification()
        }

        private fun handleCpapRead(
            uuid: UUID,
            value: ByteArray,
            status: Int,
        ) {
            if (completed.get()) return
            if (status == BluetoothGatt.GATT_SUCCESS) {
                cpapReadCount += 1
                recordCpapObservation("read", uuid, value)
            }
            cpapReadIndex += 1
            mainHandler.post { readNextCpapCharacteristic() }
        }

        @Suppress("DEPRECATION")
        private fun setupNextCpapNotification() {
            if (completed.get()) return
            val activeGatt = gatt ?: return

            while (cpapNotifyIndex < cpapNotifyQueue.size) {
                val characteristic = cpapNotifyQueue[cpapNotifyIndex]
                val enabled = try {
                    activeGatt.setCharacteristicNotification(characteristic, true)
                } catch (_: Throwable) {
                    false
                }
                if (!enabled) {
                    cpapNotifyIndex += 1
                    continue
                }

                val descriptor = characteristic.getDescriptor(CCCD)
                if (descriptor == null) {
                    cpapNotifyIndex += 1
                    continue
                }
                descriptor.value =
                    if (
                        characteristic.properties and
                        BluetoothGattCharacteristic.PROPERTY_INDICATE != 0
                    ) {
                        BluetoothGattDescriptor.ENABLE_INDICATION_VALUE
                    } else {
                        BluetoothGattDescriptor.ENABLE_NOTIFICATION_VALUE
                    }
                val started = try {
                    activeGatt.writeDescriptor(descriptor)
                } catch (_: Throwable) {
                    false
                }
                if (started) return
                cpapNotifyIndex += 1
            }

            notes.add(
                "ResMed BLE notifications are active; opening read-only application session."
            )
            beginCpapSession()
        }

        private fun recordCpapObservation(
            kind: String,
            uuid: UUID,
            value: ByteArray,
        ) {
            if (value.isEmpty()) return
            val key = "$kind • $uuid"
            val limit = minOf(value.size, 64)
            val builder = StringBuilder()
            for (index in 0 until limit) {
                builder.append(
                    (value[index].toInt() and 0xff)
                        .toString(16)
                        .padStart(2, '0')
                )
            }
            if (value.size > limit) builder.append("…")
            cpapObservations[key] = builder.toString()
            while (cpapObservations.size > 24) {
                val first = cpapObservations.keys.firstOrNull() ?: break
                cpapObservations.remove(first)
            }
        }

        // -----------------------------------------------------------------
        // ResMed AirSense 11 secure FIG session (read-only application RPC).
        // Based on the publicly documented Air11 transport: plaintext session
        // VCIDs 0x0393/0x0392, encrypted app VCIDs 0x0397/0x0396, SRP-6a
        // first pairing, HMAC reconnect, and AES-256-CBC application payloads.
        // -----------------------------------------------------------------

        private fun beginCpapSession() {
            if (completed.get() || cpapSessionStarted) return
            cpapSessionStarted = true
            val tx = cpapTx
            val rx = cpapRx
            if (tx == null || rx == null) {
                notes.add("ResMed FIG TX/RX characteristics were not found on this firmware.")
                return
            }

            val prefs = activity.getSharedPreferences("salus_resmed_session_v1", 0)
            val key = device.address.replace(":", "").lowercase()
            val clientId = prefs.getString("${key}_clientId", null)
            val masterHex = prefs.getString("${key}_masterPairKey", null)
            val master = masterHex?.let { hexToBytesOrNull(it) }
            if (!clientId.isNullOrBlank() && master?.size == 32) {
                cpapMasterPairKey = master
                sendCpapRpc(
                    "RequestSession",
                    JSONObject().put("clientId", clientId),
                    encrypted = false,
                )
                return
            }

            val code = cpapPasskey?.trim().orEmpty()
            if (!Regex("^[0-9]{4}$").matches(code)) {
                cpapPairingRequired = true
                finish()
                return
            }
            startCpapKeyExchange(code)
        }

        private fun startCpapKeyExchange(passkey: String) {
            var a: BigInteger
            do {
                a = BigInteger(256, cpapRandom)
            } while (a == BigInteger.ZERO || a >= RESMED_SRP_N)
            val public = RESMED_SRP_G.modPow(a, RESMED_SRP_N)
            cpapSrpPrivate = a
            cpapSrpPublic = public
            notes.add("Starting ResMed secure pairing exchange.")
            sendCpapRpc(
                "StartKeyExchange",
                JSONObject().put("clientPk", bytesToHex(srpPad(public)).uppercase()),
                encrypted = false,
            )
        }

        private fun sendCpapRpc(
            method: String,
            params: Any?,
            encrypted: Boolean,
        ) {
            val request = JSONObject()
            request.put("id", ++cpapRpcId)
            request.put("jsonrpc", if (method == "Get") "1.0" else "2.0")
            request.put("method", method)
            if (params != null) request.put("params", params)
            val json = request.toString().toByteArray(Charsets.UTF_8)
            val payload = if (encrypted) {
                val key = cpapSessionKey ?: run {
                    notes.add("Encrypted ResMed request blocked because session key is missing.")
                    return
                }
                aesEncryptCpap(json, key)
            } else {
                json
            }
            cpapPendingMethod = method
            val vcid = if (encrypted) RESMED_VCID_ENC_TX else RESMED_VCID_PLAIN_TX
            sendCpapFig(vcid, payload)
        }

        private fun sendCpapFig(vcid: Int, payload: ByteArray) {
            val packet = figEncode(vcid, payload)
            // 20-byte chunks work even when Android has not negotiated a larger MTU.
            // Acknowledged writes advance from onCharacteristicWrite; write commands
            // are paced by the handler so the peripheral reassembles the FIG packet.
            var offset = 0
            while (offset < packet.size) {
                val end = minOf(offset + 20, packet.size)
                cpapWriteQueue.add(packet.copyOfRange(offset, end))
                offset = end
            }
            writeNextCpapChunk()
        }

        @Suppress("DEPRECATION")
        private fun writeNextCpapChunk() {
            if (completed.get() || cpapWriteBusy) return
            val characteristic = cpapTx ?: return
            val activeGatt = gatt ?: return
            val chunk = cpapWriteQueue.poll() ?: return
            val noResponse = characteristic.properties and
                BluetoothGattCharacteristic.PROPERTY_WRITE_NO_RESPONSE != 0
            characteristic.writeType = if (noResponse) {
                BluetoothGattCharacteristic.WRITE_TYPE_NO_RESPONSE
            } else {
                BluetoothGattCharacteristic.WRITE_TYPE_DEFAULT
            }
            characteristic.value = chunk
            val started = try {
                activeGatt.writeCharacteristic(characteristic)
            } catch (_: Throwable) {
                false
            }
            if (!started) {
                finish("ResMed transport could not write the next FIG fragment.")
                return
            }
            if (noResponse) {
                mainHandler.postDelayed({ writeNextCpapChunk() }, 28L)
            } else {
                cpapWriteBusy = true
            }
        }

        private fun handleCpapTransport(chunk: ByteArray) {
            cpapFigBuffer.write(chunk)
            val packets = decodeCpapFigBuffer()
            for ((vcid, raw) in packets) {
                val payload = if (vcid == RESMED_VCID_ENC_RX) {
                    val key = cpapSessionKey ?: continue
                    try {
                        aesDecryptCpap(raw, key)
                    } catch (error: Throwable) {
                        notes.add("ResMed encrypted response could not be decrypted: ${error.javaClass.simpleName}.")
                        continue
                    }
                } else if (vcid == RESMED_VCID_PLAIN_RX) {
                    raw
                } else {
                    continue
                }
                val text = try {
                    payload.toString(Charsets.UTF_8)
                } catch (_: Throwable) {
                    continue
                }
                recordCpapObservation(
                    if (vcid == RESMED_VCID_ENC_RX) "rpc encrypted" else "rpc plain",
                    RESMED_RX,
                    payload,
                )
                val json = try {
                    JSONObject(text)
                } catch (_: Throwable) {
                    continue
                }
                handleCpapJson(json)
            }
        }

        private fun handleCpapJson(message: JSONObject) {
            val method = cpapPendingMethod
            if (message.has("error")) {
                val error = message.optJSONObject("error")
                if (method == "Get") {
                    error?.optJSONObject("data")?.let { parseCpapGetResult(it) }
                    if (metrics.isNotEmpty()) {
                        cpapAuthenticated = true
                        finish("ResMed secure session returned ${metrics.size} verified therapy metrics.")
                    } else {
                        finish("ResMed secure session opened, but the requested therapy fields were unavailable on this firmware/state.")
                    }
                } else {
                    finish("ResMed $method returned ${error?.optString("message") ?: "an error"}.")
                }
                return
            }
            val resultObject = message.optJSONObject("result")
            when (method) {
                "StartKeyExchange" -> {
                    if (resultObject == null) return
                    val serverPk = resultObject.optString("serverPk")
                    val salt = resultObject.optString("salt")
                    val passkey = cpapPasskey?.trim().orEmpty()
                    if (serverPk.isBlank() || salt.isBlank() || passkey.length != 4) {
                        finish("ResMed key exchange did not return the expected pairing fields.")
                        return
                    }
                    val proof = computeCpapSrpProof(serverPk, salt, passkey) ?: run {
                        finish("Could not compute the ResMed pairing proof.")
                        return
                    }
                    sendCpapRpc(
                        "ConfirmKeyExchange",
                        JSONObject().put("clientConfirmation", bytesToHex(proof).uppercase()),
                        encrypted = false,
                    )
                }
                "ConfirmKeyExchange" -> {
                    if (resultObject == null) return
                    val clientId = resultObject.optString("clientId")
                    val serverProof = hexToBytesOrNull(resultObject.optString("serverConfirmation"))
                    val nonce = hexToBytesOrNull(resultObject.optString("nonce"))
                    val expected = cpapExpectedServerProof
                    val master = cpapMasterPairKey
                    if (clientId.isBlank() || serverProof == null || nonce == null || expected == null || master == null || !serverProof.contentEquals(expected)) {
                        finish("ResMed secure pairing proof verification failed.")
                        return
                    }
                    val prefs = activity.getSharedPreferences("salus_resmed_session_v1", 0)
                    val key = device.address.replace(":", "").lowercase()
                    prefs.edit()
                        .putString("${key}_clientId", clientId)
                        .putString("${key}_masterPairKey", bytesToHex(master))
                        .apply()
                    cpapSessionKey = sha256(master, nonce)
                    cpapAuthenticated = true
                    requestCpapReadOnlyData()
                }
                "RequestSession" -> {
                    if (resultObject == null) return
                    val challenge = hexToBytesOrNull(resultObject.optString("challenge"))
                    val nonce = hexToBytesOrNull(resultObject.optString("nonce"))
                    val master = cpapMasterPairKey
                    if (challenge == null || nonce == null || master == null) {
                        finish("ResMed reconnect challenge was incomplete.")
                        return
                    }
                    cpapPendingNonce = nonce
                    val mac = Mac.getInstance("HmacSHA256")
                    mac.init(SecretKeySpec(master, "HmacSHA256"))
                    val response = mac.doFinal(challenge)
                    sendCpapRpc(
                        "CheckSessionIntegrity",
                        JSONObject().put("response", bytesToHex(response).uppercase()),
                        encrypted = false,
                    )
                }
                "CheckSessionIntegrity" -> {
                    val accepted = resultObject?.optBoolean("confirmation", false) == true
                    val master = cpapMasterPairKey
                    val nonce = cpapPendingNonce
                    if (!accepted || master == null || nonce == null) {
                        finish("Stored ResMed session credentials were rejected. Enter a fresh 4-digit pairing code to pair Salus again.")
                        return
                    }
                    cpapSessionKey = sha256(master, nonce)
                    cpapAuthenticated = true
                    requestCpapReadOnlyData()
                }
                "Get" -> {
                    if (resultObject != null) parseCpapGetResult(resultObject)
                    finish(
                        if (metrics.isEmpty()) {
                            "ResMed secure session opened, but no requested therapy values were available right now."
                        } else {
                            "ResMed secure session read ${metrics.size} verified therapy metric${if (metrics.size == 1) "" else "s"}."
                        }
                    )
                }
            }
        }

        private fun requestCpapReadOnlyData() {
            // These are read-only Get targets documented by the AirSense 11
            // data model. No Set/therapy-control RPC is used by Salus.
            val fields = JSONArray()
                .put("_OUD")   // current/previous report-day usage, minutes
                .put("_AHI")   // summary AHI, events/hour
                .put("_LK9")   // summary leak p95, L/s
                .put("_PM9")   // summary mask pressure p95, cmH2O
                .put("_MKF")   // live/two-second mask pressure, cmH2O
                .put("_LKF")   // live/two-second leak, L/s
                .put("_RR2")   // respiratory rate
                .put("DeviceControl")
                .put("MachineMetrics")
            sendCpapRpc("Get", fields, encrypted = true)
        }

        private fun parseCpapGetResult(obj: JSONObject) {
            fun number(vararg names: String): Double? {
                for (name in names) {
                    val value = obj.opt(name)
                    if (value is Number) return value.toDouble()
                }
                return null
            }
            number("_OUD", "OUD")?.let { if (it in 0.0..1440.0) metrics["Usage time"] = it }
            number("_AHI", "AHI", "Summary-ApneaHypopneaIndex")?.let {
                if (it in 0.0..240.0) metrics["AHI"] = it
            }
            val leak = number("_LKF", "LKF", "_LK9", "LK9")
            if (leak != null && leak in 0.0..4.0) metrics["Leak rate"] = leak * 60.0
            number("_MKF", "MKF", "_PM9", "PM9")?.let {
                if (it in 0.0..40.0) metrics["Therapy pressure"] = it
            }
            number("_RR2", "RR2")?.let {
                if (it in 0.0..80.0) metrics["Respiratory rate"] = it
            }
            obj.optJSONObject("DeviceControl")?.let {
                cpapObservations["rpc • DeviceControl"] = bytesToHex(it.toString().toByteArray(Charsets.UTF_8))
            }
            obj.optJSONObject("MachineMetrics")?.let {
                cpapObservations["rpc • MachineMetrics"] = bytesToHex(it.toString().toByteArray(Charsets.UTF_8))
            }
        }

        private fun computeCpapSrpProof(serverPkHex: String, saltHex: String, passkey: String): ByteArray? {
            return try {
                val a = cpapSrpPrivate ?: return null
                val public = cpapSrpPublic ?: return null
                val server = BigInteger(serverPkHex, 16)
                if (server.mod(RESMED_SRP_N) == BigInteger.ZERO) return null
                val k = BigInteger(1, sha256(srpPad(RESMED_SRP_N), srpPad(RESMED_SRP_G)))
                val salt = hexToBytesOrNull(saltHex) ?: return null
                val x = BigInteger(1, sha256(salt, sha256(passkey.toByteArray(Charsets.US_ASCII))))
                val u = BigInteger(1, sha256(srpPad(public), srpPad(server)))
                if (u == BigInteger.ZERO) return null
                val gx = RESMED_SRP_G.modPow(x, RESMED_SRP_N)
                val base = server.subtract(k.multiply(gx)).mod(RESMED_SRP_N)
                val exponent = a.add(u.multiply(x))
                val shared = base.modPow(exponent, RESMED_SRP_N)
                val master = sha256(srpPad(shared))
                val hn = sha256(srpPad(RESMED_SRP_N))
                val hg = sha256(srpPad(RESMED_SRP_G))
                val xor = ByteArray(hn.size) { index -> (hn[index].toInt() xor hg[index].toInt()).toByte() }
                val m1 = sha256(xor, salt, srpPad(public), srpPad(server), master)
                val m2 = sha256(srpPad(public), m1, master)
                cpapMasterPairKey = master
                cpapExpectedServerProof = m2
                m1
            } catch (_: Throwable) {
                null
            }
        }

        private fun srpPad(value: BigInteger): ByteArray {
            var raw = value.toByteArray()
            if (raw.size > 256 && raw.first() == 0.toByte()) raw = raw.copyOfRange(1, raw.size)
            val out = ByteArray(256)
            val count = minOf(raw.size, out.size)
            System.arraycopy(raw, raw.size - count, out, out.size - count, count)
            return out
        }

        private fun sha256(vararg parts: ByteArray): ByteArray {
            val digest = MessageDigest.getInstance("SHA-256")
            for (part in parts) digest.update(part)
            return digest.digest()
        }

        private fun aesEncryptCpap(json: ByteArray, key: ByteArray): ByteArray {
            val iv = ByteArray(16).also(cpapRandom::nextBytes)
            val framedLength = 2 + json.size
            val paddedLength = ((framedLength + 15) / 16) * 16
            val plain = ByteArray(paddedLength)
            plain[0] = (json.size and 0xff).toByte()
            plain[1] = ((json.size ushr 8) and 0xff).toByte()
            System.arraycopy(json, 0, plain, 2, json.size)
            val cipher = Cipher.getInstance("AES/CBC/NoPadding")
            cipher.init(Cipher.ENCRYPT_MODE, SecretKeySpec(key, "AES"), IvParameterSpec(iv))
            return iv + cipher.doFinal(plain)
        }

        private fun aesDecryptCpap(data: ByteArray, key: ByteArray): ByteArray {
            require(data.size >= 32 && (data.size - 16) % 16 == 0)
            val iv = data.copyOfRange(0, 16)
            val encrypted = data.copyOfRange(16, data.size)
            val cipher = Cipher.getInstance("AES/CBC/NoPadding")
            cipher.init(Cipher.DECRYPT_MODE, SecretKeySpec(key, "AES"), IvParameterSpec(iv))
            val plain = cipher.doFinal(encrypted)
            val length = u16(plain, 0)
            require(length <= plain.size - 2)
            return plain.copyOfRange(2, 2 + length)
        }

        private fun figEncode(vcid: Int, payload: ByteArray): ByteArray {
            val header = ByteArray(8)
            putLe16(header, 0, vcid)
            putLe16(header, 2, payload.size)
            putLe32(header, 4, crc32(payload))
            val out = ByteArray(16 + payload.size)
            putLe32(out, 0, RESMED_FIG_SYNC.toLong() and 0xffffffffL)
            System.arraycopy(header, 0, out, 4, header.size)
            putLe32(out, 12, crc32(header))
            System.arraycopy(payload, 0, out, 16, payload.size)
            return out
        }

        private fun decodeCpapFigBuffer(): List<Pair<Int, ByteArray>> {
            val output = mutableListOf<Pair<Int, ByteArray>>()
            var bytes = cpapFigBuffer.toByteArray()
            var cursor = 0
            while (cursor + 16 <= bytes.size) {
                var sync = -1
                var i = cursor
                while (i + 4 <= bytes.size) {
                    if (u32(bytes, i) == (RESMED_FIG_SYNC.toLong() and 0xffffffffL)) {
                        sync = i
                        break
                    }
                    i += 1
                }
                if (sync < 0) break
                if (sync + 16 > bytes.size) break
                val vcid = u16(bytes, sync + 4)
                val length = u16(bytes, sync + 6)
                val payloadCrc = u32(bytes, sync + 8)
                val headerCrc = u32(bytes, sync + 12)
                val header = bytes.copyOfRange(sync + 4, sync + 12)
                if (crc32(header) != headerCrc) {
                    cursor = sync + 4
                    continue
                }
                val end = sync + 16 + length
                if (end > bytes.size) {
                    cursor = sync
                    break
                }
                val payload = bytes.copyOfRange(sync + 16, end)
                if (crc32(payload) == payloadCrc) output.add(vcid to payload)
                cursor = end
            }
            val remainder = if (cursor < bytes.size) bytes.copyOfRange(cursor, bytes.size) else byteArrayOf()
            cpapFigBuffer.reset()
            if (remainder.isNotEmpty()) cpapFigBuffer.write(remainder)
            return output
        }

        private fun crc32(data: ByteArray): Long {
            val crc = CRC32()
            crc.update(data)
            return crc.value
        }

        private fun putLe16(target: ByteArray, offset: Int, value: Int) {
            target[offset] = (value and 0xff).toByte()
            target[offset + 1] = ((value ushr 8) and 0xff).toByte()
        }

        private fun putLe32(target: ByteArray, offset: Int, value: Long) {
            target[offset] = (value and 0xff).toByte()
            target[offset + 1] = ((value ushr 8) and 0xff).toByte()
            target[offset + 2] = ((value ushr 16) and 0xff).toByte()
            target[offset + 3] = ((value ushr 24) and 0xff).toByte()
        }

        private fun bytesToHex(bytes: ByteArray): String = buildString(bytes.size * 2) {
            for (value in bytes) append((value.toInt() and 0xff).toString(16).padStart(2, '0'))
        }

        private fun hexToBytesOrNull(value: String): ByteArray? {
            val clean = value.trim()
            if (clean.length % 2 != 0 || clean.isEmpty()) return null
            return try {
                ByteArray(clean.length / 2) { index -> clean.substring(index * 2, index * 2 + 2).toInt(16).toByte() }
            } catch (_: Throwable) {
                null
            }
        }

        // -----------------------------------------------------------------
        // COLMI / QRing R02-family reader.
        // -----------------------------------------------------------------

        private fun startRing(
            gatt: BluetoothGatt,
            service: BluetoothGattService,
        ) {
            readerName = "COLMI / QRing"
            mode = "ring"
            ringWrite = service.getCharacteristic(RING_WRITE)
            ringNotify = service.getCharacteristic(RING_NOTIFY)

            val bigService = gatt.getService(RING_BIG_SERVICE)
            ringBigWrite = bigService?.getCharacteristic(RING_BIG_WRITE)
            ringBigNotify = bigService?.getCharacteristic(RING_BIG_NOTIFY)

            if (ringWrite == null || ringNotify == null) {
                finish(
                    "COLMI UART service was found, but required characteristics are missing."
                )
                return
            }

            ringNotifyStage = 1
            if (!enableNotify(gatt, ringNotify!!)) {
                finish("COLMI notification channel could not be enabled.")
                return
            }

            // Some Android stacks omit a descriptor callback. Do not deadlock.
            mainHandler.postDelayed(
                {
                    if (!completed.get() && ringNotifyStage < 3) {
                        ringBigNotify?.let { enableNotify(gatt, it) }
                        ringNotifyStage = 3
                        startRingRequests()
                    }
                },
                900L,
            )
        }

        private fun ringPacket(
            command: Int,
            payload: ByteArray = byteArrayOf(),
        ): ByteArray {
            val out = ByteArray(16)
            out[0] = command.toByte()
            for (index in 0 until minOf(payload.size, 14)) {
                out[index + 1] = payload[index]
            }
            var checksum = 0
            for (index in 0 until 15) {
                checksum =
                    (checksum + (out[index].toInt() and 0xff)) and 0xff
            }
            out[15] = checksum.toByte()
            return out
        }

        private fun ringSend(
            command: Int,
            payload: ByteArray = byteArrayOf(),
        ) {
            val activeGatt = gatt ?: return
            val characteristic = ringWrite ?: return
            writeCharacteristic(activeGatt, characteristic, ringPacket(command, payload))
        }

        private fun requestRingBigData(dataId: Int) {
            val activeGatt = gatt ?: return
            val characteristic = ringBigWrite ?: return
            ringBigBuffer.reset()
            writeCharacteristic(
                activeGatt,
                characteristic,
                byteArrayOf(
                    0xbc.toByte(),
                    dataId.toByte(),
                    0x01,
                    0x00,
                    0xff.toByte(),
                    0x00,
                    0xff.toByte(),
                ),
            )
        }

        private fun startRingRequests() {
            if (completed.get()) return

            val midnight = Calendar.getInstance()
            midnight.set(Calendar.HOUR_OF_DAY, 0)
            midnight.set(Calendar.MINUTE, 0)
            midnight.set(Calendar.SECOND, 0)
            midnight.set(Calendar.MILLISECOND, 0)
            val epoch = midnight.timeInMillis / 1000L
            val day = byteArrayOf(
                (epoch and 0xff).toByte(),
                ((epoch shr 8) and 0xff).toByte(),
                ((epoch shr 16) and 0xff).toByte(),
                ((epoch shr 24) and 0xff).toByte(),
            )

            ringSend(3) // battery
            mainHandler.postDelayed(
                { ringSend(67, byteArrayOf(0, 0x0f, 0, 0x5f, 1)) },
                450L,
            )
            mainHandler.postDelayed({ ringSend(21, day) }, 1700L)

            // Start HR sensor then poll computed BPM with command 30.
            mainHandler.postDelayed(
                { ringSend(105, byteArrayOf(1, 1)) },
                3600L,
            )
            repeat(4) { index ->
                mainHandler.postDelayed(
                    { ringSend(30, byteArrayOf(3)) },
                    4400L + index * 650L,
                )
            }
            mainHandler.postDelayed(
                { ringSend(106, byteArrayOf(1, 0, 0)) },
                7000L,
            )

            // Real-time SpO2.
            mainHandler.postDelayed(
                { ringSend(105, byteArrayOf(3, 1)) },
                7200L,
            )
            mainHandler.postDelayed(
                { ringSend(106, byteArrayOf(3, 0, 0)) },
                8600L,
            )

            // Firmware HRV proxy. Kept separate from RMSSD.
            mainHandler.postDelayed(
                { ringSend(57, byteArrayOf(0)) },
                8800L,
            )

            mainHandler.postDelayed(
                { requestRingBigData(0x27) },
                10300L,
            )
            mainHandler.postDelayed(
                {
                    if (!ringSleepSeen && !ringSpo2Requested) {
                        ringSpo2Requested = true
                        requestRingBigData(0x2a)
                    }
                },
                12800L,
            )
        }

        private fun parseRingPacket(packet: ByteArray) {
            if (packet.size < 2) return

            when (packet[0].toInt() and 0xff) {
                3 -> {
                    val battery = packet[1].toInt() and 0xff
                    if (battery in 1..100) {
                        metrics["Battery"] = battery.toDouble()
                    }
                }

                30 -> {
                    val bpm = packet[1].toInt() and 0xff
                    if (bpm in 30..240) {
                        metrics["Heart rate"] = bpm.toDouble()
                    }
                }

                21 -> {
                    val subtype = packet[1].toInt() and 0xff
                    if (subtype == 0xff || subtype == 0) return
                    val start = if (subtype == 1) 6 else 2
                    for (index in start until minOf(packet.size - 1, 15)) {
                        val bpm = packet[index].toInt() and 0xff
                        if (bpm in 30..240) ringLatestHr = bpm
                    }
                    if (ringLatestHr > 0) {
                        metrics["Heart rate"] = ringLatestHr.toDouble()
                    }
                }

                67 -> {
                    val marker = packet[1].toInt() and 0xff
                    if (marker == 0xff) return
                    if (marker == 0xf0) {
                        ringStepTotal = 0
                        ringCaloriesTotal = 0
                        ringNewCalorieProtocol =
                            packet.size > 3 && (packet[3].toInt() and 0xff) == 1
                        return
                    }
                    if (packet.size >= 13) {
                        var calories = u16(packet, 7)
                        if (ringNewCalorieProtocol) calories *= 10
                        ringStepTotal += u16(packet, 9)
                        ringCaloriesTotal += calories

                        val recordIndex = packet[5].toInt() and 0xff
                        val recordCount = packet[6].toInt() and 0xff
                        if (recordCount > 0 && recordIndex >= recordCount - 1) {
                            metrics["Steps"] = ringStepTotal.toDouble()
                            if (ringCaloriesTotal > 0) {
                                metrics["Active calories"] =
                                    ringCaloriesTotal.toDouble()
                            }
                        }
                    }
                }

                57 -> {
                    val index = packet[1].toInt() and 0xff
                    if (index == 0xff) return
                    if (index == 0) {
                        ringHrvPageCount =
                            if (packet.size > 2) packet[2].toInt() and 0xff else 0
                        for (page in 1..ringHrvPageCount) {
                            mainHandler.postDelayed(
                                { ringSend(57, byteArrayOf(page.toByte())) },
                                page * 120L,
                            )
                        }
                        return
                    }
                    for (position in 3 until minOf(packet.size - 1, 15)) {
                        val value = packet[position].toInt() and 0xff
                        if (value != 0 && value != 0xff) {
                            ringHrvProxySum += value
                            ringHrvProxyCount += 1
                        }
                    }
                }

                105 -> {
                    if (packet.size < 4) return
                    val kind = packet[1].toInt() and 0xff
                    val error = packet[2].toInt() and 0xff
                    val value = packet[3].toInt() and 0xff
                    if (error == 0 && kind == 3 && value in 70..100) {
                        metrics["SpO2"] = value.toDouble()
                    }
                }
            }
        }

        private fun parseRingBigData(chunk: ByteArray) {
            ringBigBuffer.write(chunk)
            val bytes = ringBigBuffer.toByteArray()
            if (bytes.size < 6) return

            val dataLength = u16(bytes, 2)
            val total = 6 + dataLength
            if (bytes.size < total) return

            val dataId = bytes[1].toInt() and 0xff
            val payload = bytes.copyOfRange(6, total)
            ringBigBuffer.reset()

            if (dataId == 0x27) {
                ringSleepSeen = true
                parseRingSleep(payload)
                if (!ringSpo2Requested) {
                    ringSpo2Requested = true
                    mainHandler.postDelayed(
                        { requestRingBigData(0x2a) },
                        300L,
                    )
                }
            } else if (dataId == 0x2a) {
                parseRingSpo2(payload)
            }
        }

        private fun parseRingSleep(payload: ByteArray) {
            if (payload.isEmpty()) return
            val nightCount = payload[0].toInt() and 0xff
            var pointer = 1
            var bestDaysAgo = Int.MAX_VALUE
            var bestLight = 0
            var bestDeep = 0
            var bestRem = 0
            var bestAwake = 0

            repeat(nightCount) {
                if (pointer + 6 > payload.size) return@repeat
                val daysAgo = payload[pointer].toInt() and 0xff
                val recordBytes = payload[pointer + 1].toInt() and 0xff
                val end = pointer + 2 + recordBytes
                if (end <= pointer || end > payload.size) return@repeat

                var light = 0
                var deep = 0
                var rem = 0
                var awake = 0
                var cursor = pointer + 6

                while (cursor + 1 < end) {
                    val stage = payload[cursor].toInt() and 0xff
                    val minutes = payload[cursor + 1].toInt() and 0xff
                    when (stage) {
                        2 -> light += minutes
                        3 -> deep += minutes
                        4 -> rem += minutes
                        5 -> awake += minutes
                    }
                    cursor += 2
                }

                val asleep = light + deep + rem
                if (asleep > 0 && daysAgo < bestDaysAgo) {
                    bestDaysAgo = daysAgo
                    bestLight = light
                    bestDeep = deep
                    bestRem = rem
                    bestAwake = awake
                }
                pointer = end
            }

            val asleep = bestLight + bestDeep + bestRem
            if (asleep > 0) {
                metrics["Sleep"] = asleep.toDouble()
                metrics["Sleep light"] = bestLight.toDouble()
                metrics["Sleep deep"] = bestDeep.toDouble()
                metrics["Sleep REM"] = bestRem.toDouble()
                metrics["Sleep awake"] = bestAwake.toDouble()
            }
        }

        private fun parseRingSpo2(payload: ByteArray) {
            var bestDaysAgo = Int.MAX_VALUE
            var bestHour = -1
            var latest = 0.0
            var base = 0

            while (base + 49 <= payload.size) {
                val daysAgo = payload[base].toInt() and 0xff
                for (hour in 0 until 24) {
                    val maximum = payload[base + 1 + hour * 2].toInt() and 0xff
                    val minimum = payload[base + 2 + hour * 2].toInt() and 0xff
                    if (maximum == 0 && minimum == 0) continue

                    if (
                        daysAgo < bestDaysAgo ||
                        (daysAgo == bestDaysAgo && hour > bestHour)
                    ) {
                        bestDaysAgo = daysAgo
                        bestHour = hour
                        val low = if (minimum > 0) minimum else maximum
                        val high = if (maximum > 0) maximum else minimum
                        latest = (low + high) / 2.0
                    }
                }
                base += 49
            }

            if (latest in 70.0..100.0) {
                metrics["SpO2"] = latest
            }
        }

        // -----------------------------------------------------------------
        // Garmin Multi-Link real-time reader.
        // -----------------------------------------------------------------

        private fun startGarmin(
            gatt: BluetoothGatt,
            service: BluetoothGattService,
        ) {
            readerName = "Garmin Multi-Link"
            mode = "garmin"

            var selectedRx: BluetoothGattCharacteristic? = null
            var selectedTx: BluetoothGattCharacteristic? = null

            for (index in 0..4) {
                val rxCode = 0x2810 + index
                val txCode = rxCode + 0x10
                val rx = service.getCharacteristic(
                    UUID.fromString(
                        "6a4e${rxCode.toString(16).padStart(4, '0')}-667b-11e3-949a-0800200c9a66"
                    )
                )
                val tx = service.getCharacteristic(
                    UUID.fromString(
                        "6a4e${txCode.toString(16).padStart(4, '0')}-667b-11e3-949a-0800200c9a66"
                    )
                )

                if (
                    rx != null &&
                    tx != null &&
                    rx.properties and BluetoothGattCharacteristic.PROPERTY_NOTIFY != 0
                ) {
                    selectedRx = rx
                    selectedTx = tx
                    break
                }
            }

            if (selectedRx == null || selectedTx == null) {
                finish(
                    "Garmin Multi-Link is present, but no usable notify/write pair was found."
                )
                return
            }

            garminRx = selectedRx
            garminTx = selectedTx

            if (!enableNotify(gatt, selectedRx)) {
                finish("Garmin Multi-Link notification channel could not be enabled.")
                return
            }

            // Descriptor callback can be skipped on a few Android stacks.
            mainHandler.postDelayed(
                {
                    if (!completed.get() && !garminRegistrationStarted) {
                        startGarminHandshake()
                    }
                },
                1000L,
            )
        }

        private fun garminWrite(data: ByteArray): Boolean {
            val activeGatt = gatt ?: return false
            val characteristic = garminTx ?: return false
            return writeCharacteristic(activeGatt, characteristic, data)
        }

        private fun startGarminHandshake() {
            if (garminRegistrationStarted || completed.get()) return
            garminRegistrationStarted = true

            // CLOSE_ALL: handle 0, type 5, reserved u16=0, clientId=2, flag=0.
            garminWrite(
                byteArrayOf(
                    0x00,
                    0x05,
                    0x00, 0x00,
                    0x02, 0x00, 0x00, 0x00,
                    0x00, 0x00, 0x00, 0x00,
                    0x00,
                )
            )

            mainHandler.postDelayed(
                {
                    if (!completed.get()) {
                        garminRegisterIndex = 0
                        garminPendingService = null
                        registerNextGarmin()
                    }
                },
                700L,
            )
        }

        private fun registerPacket(service: Int): ByteArray {
            // handle 0 + REGISTER_ML_REQ + clientId(8 LE)=2 + service u16 + flag.
            return byteArrayOf(
                0x00,
                0x00,
                0x02, 0x00, 0x00, 0x00,
                0x00, 0x00, 0x00, 0x00,
                (service and 0xff).toByte(),
                ((service ushr 8) and 0xff).toByte(),
                0x00,
            )
        }

        private fun registerNextGarmin() {
            if (
                completed.get() ||
                garminPendingService != null ||
                garminRegisterIndex >= GARMIN_SERVICES.size
            ) {
                return
            }

            val service = GARMIN_SERVICES[garminRegisterIndex]
            garminPendingService = service
            if (!garminWrite(registerPacket(service))) {
                garminPendingService = null
                garminRegisterIndex += 1
                mainHandler.postDelayed({ registerNextGarmin() }, 120L)
                return
            }

            // Some firmware ignores unsupported service ids instead of replying.
            mainHandler.postDelayed(
                {
                    if (garminPendingService == service) {
                        garminPendingService = null
                        garminRegisterIndex += 1
                        registerNextGarmin()
                    }
                },
                900L,
            )
        }

        private fun parseGarminPacket(value: ByteArray) {
            if (value.size < 2) return
            val first = value[0].toInt() and 0xff

            if (first == 0) {
                parseGarminControl(value)
                return
            }

            val handle =
                if (first and 0x80 != 0) {
                    (first and 0x70) ushr 4
                } else {
                    first
                }
            val service = garminHandleToService[handle] ?: return
            if (service == GARMIN_GFDI || value.size <= 1) return

            parseGarminTelemetry(
                service,
                value.copyOfRange(1, value.size),
            )
        }

        private fun parseGarminControl(value: ByteArray) {
            if (value.size < 2) return
            val type = value[1].toInt() and 0xff

            // REGISTER_ML_RESP. Public captures place service/status/handle here.
            if (type == 1 && value.size >= 14) {
                val service = u16(value, 10)
                val status = value[12].toInt() and 0xff
                val handle = value[13].toInt() and 0xff

                if (status == 0 && handle in 1..127) {
                    garminHandleToService[handle] = service
                    if (service != GARMIN_GFDI) {
                        // A one-byte 1 payload starts the real-time stream.
                        garminWrite(byteArrayOf(handle.toByte(), 0x01))
                    }
                }

                if (garminPendingService == service) {
                    garminPendingService = null
                    garminRegisterIndex += 1
                    mainHandler.postDelayed({ registerNextGarmin() }, 120L)
                }
            }
        }

        private fun parseGarminTelemetry(
            service: Int,
            payload: ByteArray,
        ) {
            when (service) {
                GARMIN_REALTIME_HR -> {
                    if (payload.size >= 3) {
                        val heart = payload[1].toInt() and 0xff
                        val resting = payload[2].toInt() and 0xff
                        if (heart in 30..240) {
                            metrics["Heart rate"] = heart.toDouble()
                        }
                        if (resting in 30..140) {
                            metrics["Resting heart rate"] = resting.toDouble()
                        }
                    }
                }

                GARMIN_REALTIME_STEPS -> {
                    if (payload.size >= 8) {
                        val steps = u32(payload, 0)
                        if (steps in 0L..250000L) {
                            metrics["Steps"] = steps.toDouble()
                        }
                    }
                }

                GARMIN_REALTIME_CALORIES -> {
                    if (payload.size >= 8) {
                        val active = u32(payload, 4)
                        if (active in 0L..50000L) {
                            metrics["Active calories"] = active.toDouble()
                        }
                    }
                }

                GARMIN_REALTIME_HRV -> {
                    if (payload.size >= 2) {
                        val rr = u16(payload, 0)
                        if (rr in 250..2500) {
                            garminRrMs.add(rr.toDouble())
                        }
                    }
                }

                GARMIN_REALTIME_STRESS -> {
                    if (payload.isNotEmpty()) {
                        val stress = payload[0].toInt()
                        if (stress in 0..100) {
                            metrics["Stress"] = stress.toDouble()
                        }
                    }
                }

                GARMIN_REALTIME_SPO2 -> {
                    if (payload.isNotEmpty()) {
                        val spo2 = payload[0].toInt() and 0xff
                        if (spo2 in 70..100) {
                            metrics["SpO2"] = spo2.toDouble()
                        }
                    }
                }

                GARMIN_REALTIME_BODY_BATTERY -> {
                    if (payload.isNotEmpty()) {
                        val bodyBattery = payload[0].toInt()
                        if (bodyBattery in 0..100) {
                            metrics["Body battery"] = bodyBattery.toDouble()
                        }
                    }
                }

                GARMIN_REALTIME_RESPIRATION -> {
                    if (payload.isNotEmpty()) {
                        val breaths = payload[0].toInt()
                        if (breaths in 1..80) {
                            metrics["Respiratory rate"] = breaths.toDouble()
                        }
                    }
                }
            }
        }
    }

    private fun hasBluetoothPermission(): Boolean {
        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S) return true
        return activity.checkSelfPermission(Manifest.permission.BLUETOOTH_SCAN) ==
            PackageManager.PERMISSION_GRANTED &&
            activity.checkSelfPermission(Manifest.permission.BLUETOOTH_CONNECT) ==
            PackageManager.PERMISSION_GRANTED
    }
}
